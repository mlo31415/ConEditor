# Secrets / per-user -- never commit
FTP Credentials.json
ConEditor settings.json

# Python virtual environment
.venv/
venv/

# Python bytecode / caches
__pycache__/
*.py[cod]

# PyInstaller build artifacts
# NOTE: unlike most projects, do NOT ignore *.spec -- Build.bat builds FROM ConEditor.spec, which is committed.
build/
dist/
*.exe

# IDE / OS
.idea/
desktop.ini

# Runtime logs
Log -- *.txt
Log (Errors) -- *.txt
Log.txt
Log Errors.txt
*.log

# Alternate/unused icon kept locally
Real ConEditor.ico

# Symlink-creation scripts -- machine-specific, kept locally only (both casings are in use)
mkLinks*.bat
mklinks*.bat

# Symlinks to shared packages -- machine-specific, regenerated locally by the mklinks*.bat scripts.
# Do NOT commit these: they point to absolute paths on the dev's machine and would check out as
# broken stubs elsewhere. The mklinks*.bat scripts (which ARE committed) recreate them.
FTP.py
FanzineDateTime.py
FanzineIssueSpecPackage.py
HelpersPackage.py
Locale.py
Log.py
PDFHelpers.py
Settings.py
WxDataGrid.py
WxHelpers.py
